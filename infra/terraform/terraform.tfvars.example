# Use a real, monitored address. This value is ignored when saved as terraform.tfvars.
sec_user_agent = "filing-corpus-pipeline your-email@example.com"

aws_region = "eu-west-1"

# Replace this with the target account ID. Terraform refuses other accounts.
allowed_account_ids = ["123456789012"]

# The source-controlled target set is config/discovery-targets/dev.json.
# This execution window is global across every company registration.
lookback_days = 7

schedule_expression = "rate(6 hours)"

# Deploy disabled, run a manual execution, then enable recurring discovery.
schedule_enabled = false

# Keep provider pressure and burst cost bounded. The defaults allow two filing
# downloads at once, a five-minute recoverable claim, a 25 MiB document, and a
# 2 MiB SEC filing-detail page used to resolve exhibits.
acquisition_map_max_concurrency        = 2
acquisition_lease_seconds              = 300
acquisition_max_document_bytes         = 26214400
acquisition_max_filing_detail_bytes    = 2097152

# Normalization runs after acquisition within each Map iteration. Its longer
# lease covers bounded parsing and it loads no more than acquisition accepts.
normalization_lease_seconds      = 600
normalization_max_document_bytes = 26214400

# Leave unset in quota-constrained accounts. Enable only after confirming that
# the regional Lambda concurrency quota has enough unreserved headroom.
# discovery_lambda_reserved_concurrency = 1

# Keep false while iterating locally. Enable for a long-lived environment after
# verifying the destroy/recovery procedure.
registry_deletion_protection_enabled = false

# Leave false so Terraform refuses to delete a bucket containing any object
# versions. Set true only for an explicitly disposable environment.
raw_bucket_force_destroy = false
normalized_bucket_force_destroy = false
target_config_bucket_force_destroy = false
